<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Assistant</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css" />
</head>

<body>

    <div class="app-container">
        
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i data-lucide="bot" class="icon"></i>
                    <span>AI Assistant</span>
                </div>
                <button class="close-sidebar-btn" id="closeSidebarBtn">
                    <i data-lucide="x"></i>
                </button>
            </div>

            <div class="sidebar-search">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="chatSearchInput" placeholder="Search chats..." aria-label="Search chats">
                <button id="clearSearchBtn" class="clear-search-btn" aria-label="Clear search" style="display: none;">
                    <i data-lucide="x"></i>
                </button>
            </div>

            <button class="new-chat-btn">
                <i data-lucide="plus"></i>
                New Chat
            </button>

            <div class="history-list">
                <!-- Rendered by JS -->
            </div>

            <div class="user-profile">
                <div class="avatar">
                    <i data-lucide="user"></i>
                </div>
                <div class="user-info">
                    <div class="user-name">User</div>
                    <div class="user-plan">Pro Plan</div>
                </div>
                <i data-lucide="settings" class="settings-icon"></i>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            
            <header class="mobile-header">
                <button id="openSidebarBtn" class="menu-btn">
                    <i data-lucide="menu"></i>
                </button>
                <div class="header-title">AI Assistant</div>
                <button class="new-chat-mobile-btn">
                    <i data-lucide="edit"></i>
                </button>
            </header>

            <div class="chat-area">
                <div id="messages"></div>
            </div>

            <div class="input-container">
                <div class="input-wrapper">
                    <div class="input-box">
                        <textarea id="prompt" rows="1" placeholder="Message AI Assistant..."></textarea>
                        <button id="sendBtn" title="Send message">
                            <i data-lucide="send-horizontal"></i>
                        </button>
                    </div>
                    <div class="footer-text">
                        AI can make mistakes. Check important info.
                    </div>
                </div>
            </div>

        </main>
    </div>
    <!-- Rename Modal -->
    <div id="renameModal" class="modal-backdrop" style="display: none;" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="renameModalTitle">
            <h3 id="renameModalTitle" class="modal-title">Rename Chat</h3>
            <input type="text" id="renameInput" class="modal-input" aria-label="Chat title input" />
            <div id="renameError" class="modal-error" aria-live="polite"></div>
            <div class="modal-actions">
                <button id="cancelRenameBtn" class="btn-secondary">Cancel</button>
                <button id="saveRenameBtn" class="btn-primary">Save</button>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal" class="modal-backdrop" style="display: none;" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
            <h3 id="deleteModalTitle" class="modal-title">Delete Chat</h3>
            <p style="margin-bottom: 8px; font-size: 0.95rem; color: var(--text-primary);">Are you sure you want to delete this chat?</p>
            <p style="margin-bottom: 24px; font-size: 0.9rem; color: var(--text-secondary);">Chat: <strong id="deleteModalChatTitle" style="color: var(--text-primary);"></strong></p>
            <div class="modal-actions">
                <button id="cancelDeleteBtn" class="btn-secondary">Cancel</button>
                <button id="confirmDeleteBtn" class="btn-danger"><i data-lucide="trash-2" style="width: 16px; height: 16px; margin-right: 6px;"></i>Delete</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();
    </script>
    <script src="/js/script.js"></script>
    <script src="/js/ui.js"></script>

</body>

</html>